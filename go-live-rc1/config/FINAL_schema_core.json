    { "name": "od_pct",                   "formula": "od_aed / ms_due_itd_aed * 100",                              "note": "Denominator = MS Due ITD. Group CIV = 3.88%" },
    { "name": "efficiency_30d",           "formula": "dues_collected_aed / booksize_bom_aed * 100",               "note": "2025 avg = 34.8%. Deprecated 18% from v3 is WRONG." },
    { "name": "book_penetration_pct",     "formula": "annual_advance_aed / opening_forward_book_aed * 100",       "note": "2025 = 8.15% (÷40B). 2026 target = 10.6% (÷PIPELINE_ADV_DENOM 37.8B)" },
    { "name": "cy_mix_pct",               "formula": "cy_advance_aed / total_advance_aed * 100",                  "note": "Jan 2025 CY = 70.1%. 2026 YTD = 81.1% (CY_ADV_MIX_YTD constant)" },
    { "name": "da_cagr",                  "formula": "( da_2025 / da_2021 ) ^ (1/4) - 1",                         "note": "867M → 12,966M → 97% CAGR" },
    { "name": "achievement_pct",          "formula": "actual_collected_aed / target_aed * 100",                   "note": "Collector-level and entity-level KPI" },
    { "name": "march_collectible_window", "formula": "od_today_aed + march_ms_due_aed",                           "note": "1,650.1M + ~914M = ~2,564M" },
    { "name": "npv_bank_cost",            "formula": "advance_aed * 0.0475 * (avg_lead_days / 365)",              "note": "652M × 4.75% × (248/365) = ~31M [PROJECTED]" },
    { "name": "npv_rebate_cost",          "formula": "advance_aed * npv_proposed_rate * (avg_lead_days / 365)",   "note": "652M × 4.3% × (248/365) = ~21M [PROJECTED]" },
    { "name": "npv_incremental_inflow",   "formula": "advance_collected_with_rebate - advance_without_rebate",    "note": "~652M [PROJECTED — not Actual]" }
  ]
}
