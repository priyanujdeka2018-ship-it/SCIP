  "derived_metrics": [
    {
      "name": "od_pct",
      "formula": "od_aed / ms_due_itd_aed * 100",
      "note": "Correct denominator is MS Due ITD, NOT purchase price. CIV total = 3.88%"
    },
    {
      "name": "efficiency_30d",
      "formula": "dues_collected_aed / booksize_bom_aed * 100",
      "note": "2025 avg = 34.8%. Old v3 value of 18% is incorrect."
    },
    {
      "name": "book_penetration_pct",
      "formula": "annual_advance_aed / opening_forward_book_aed * 100",
      "note": "2025 = 8.15% (÷40B). 2026 target = 10.6% (÷37.8B from R36)."
    },
    {
      "name": "cy_mix_pct",
      "formula": "cy_advance_aed / total_advance_aed * 100",
      "note": "Jan 2025 CY = 70.1% (FY = 29.9%). 2026 YTD = 81.1%."
    },
    {
      "name": "da_cagr",
      "formula": "( da_2025 / da_2021 ) ^ (1/4) - 1",
      "note": "2021=867M → 2025=12,966M → CAGR = 97%"
    },
    {
      "name": "achievement_pct",
      "formula": "actual_collected_aed / target_aed * 100",
      "note": "Collector-level and entity-level KPI"
    },
    {
      "name": "march_collectible_window_aed",
      "formula": "od_today_aed + march_ms_due_aed",
      "note": "1,650.1M OD + ~914M MS = 2,564M ≈ 2.56B"
    }
  ],

