{
  "_meta": {
    "file": "pipeline_config.json",
    "platform": "Sobha Collections Intelligence Platform",
    "version": "v7",
    "authority": "MASTER_ARCHITECTURE_v9_1.md",
    "purpose": "Column mappings and aggregation rules per R-series source. This is the ONLY file edited when pipeline sources change. data_loader.py reads this file. No submodule is ever edited to reflect source changes.",
    "edit_rule": "Only Priyanuj or Claude edits this file. One entry per R-series report. Add/remove entries here when new reports are onboarded or retired. Never touch data_loader.py for a column rename.",
    "format_rule": "All source files are xlsx. openpyxl reads them. Multi-sheet files use sheet_name param. No xlsb, PDF, or Word accepted.",
    "unit_rule": "All monetary output from data_loader is in AED base units (not millions). utils.fmt_aed_millions() handles display conversion.",
    "naming_convention": "snake_case throughout. _aed suffix = AED base units. _pct suffix = 0-100 scale. _m suffix FORBIDDEN in this config — all values are base AED.",
    "changelog": {
      "v7": "R18 entry fully rebuilt. Reflects actual file structure: multi-sheet workbook, active sheet = Overdue-1, positional column reads (not header-name reads), Grand Total row for OD_TODAY and ageing buckets, Sub Total rows (A-E/F/G) for entity OD. SNAPSHOT_DATE read from header cell. Flat column_map removed — replaced with positional_read spec."
    }
  },

  "sources": {

    "R01": {
      "id": "R01",
      "label": "Year-End Collections Snapshot 2021–2025",
      "file": "R01_year_end_snap.xlsx",
      "sheet_name": 0,
      "file_type": "xlsx",
      "granularity": "annual",
      "data_date": "2026-03",
      "sections_used": ["S01"],
      "graceful_degradation": "show_last_known",
      "column_map": {
        "Year":                  "year",
        "Entity":                "entity",
        "Dues":                  "dues_aed",
        "Advance":               "advance_aed",
        "New Sales":             "new_sales_aed",
        "D+A":                   "total_da_aed",
        "Total Collections":     "total_collections_aed",
        "LP Charges":            "lp_charges_aed"
      },
      "column_types": {
        "year":                  "int",
        "entity":                "str",
        "dues_aed":              "float",
        "advance_aed":           "float",
        "new_sales_aed":         "float",
        "total_da_aed":          "float",
        "total_collections_aed": "float",
        "lp_charges_aed":        "float"
      },
      "aggregations": {
        "da_cagr_anchor_2021":   { "op": "filter_sum", "col": "total_da_aed",  "filter": {"year": 2021, "entity": "Group"} },
        "da_cagr_anchor_2025":   { "op": "filter_sum", "col": "total_da_aed",  "filter": {"year": 2025, "entity": "Group"} },
        "total_2025_group":      { "op": "filter_sum", "col": "total_collections_aed", "filter": {"year": 2025, "entity": "Group"} },
        "lp_growth_2021":        { "op": "filter_sum", "col": "lp_charges_aed","filter": {"year": 2021, "entity": "Group"} },
        "lp_growth_2025":        { "op": "filter_sum", "col": "lp_charges_aed","filter": {"year": 2025, "entity": "Group"} }
      },
      "notes": "R01 is a PDF source — manual extraction required before first load. Once extracted to xlsx, treated identically to other R-series."
    },

    "R02": {
      "id": "R02",
      "label": "MDO Monthly Targets vs Actuals 2026",
      "file": "R02_mdo_targets.xlsx",
      "sheet_name": 0,
      "file_type": "xlsx",
      "granularity": "monthly",
      "data_date_col": "month",
      "sections_used": ["S02", "S03"],
      "graceful_degradation": "show_last_known",
      "column_map": {
        "Month":              "month",
        "Entity":             "entity",
        "Target Type":        "target_type",
        "Dues Target":        "dues_target_aed",
        "Dues Actual":        "dues_actual_aed",
        "Advance Target":     "advance_target_aed",
        "Advance Actual":     "advance_actual_aed",
        "D+A Target":         "da_target_aed",
        "D+A Actual":         "da_actual_aed",
        "Achievement%":       "achievement_pct"
      },
      "column_types": {
        "month":              "datetime",
        "entity":             "str",
        "target_type":        "str",
        "dues_target_aed":    "float",
        "dues_actual_aed":    "float",
        "advance_target_aed": "float",
        "advance_actual_aed": "float",
        "da_target_aed":      "float",
        "da_actual_aed":      "float",
        "achievement_pct":    "float"
      },
      "aggregations": {
        "fy_dues_target_group":    { "op": "filter_sum", "col": "dues_target_aed",    "filter": {"entity": "Group"} },
        "fy_advance_target_group": { "op": "filter_sum", "col": "advance_target_aed", "filter": {"entity": "Group"} },
        "q1_dues_actual_group":    { "op": "filter_sum", "col": "dues_actual_aed",    "filter": {"entity": "Group", "month_in": ["2026-01","2026-02","2026-03"]} },
        "q1_advance_actual_group": { "op": "filter_sum", "col": "advance_actual_aed", "filter": {"entity": "Group", "month_in": ["2026-01","2026-02","2026-03"]} }
      },
      "disambiguation_note": "MDO Dues = Dues-only target. Finance Dues (R04) = D+A combined. Never conflate. Both must be labelled on-screen."
    },

    "R03": {
      "id": "R03",
      "label": "Entity Portfolio Snapshot — Qualified Units",
      "file": "R03_entity_portfolio_snapshot.xlsx",
      "sheet_name": 0,
      "file_type": "xlsx",
      "granularity": "entity_project",
      "sections_used": ["S01"],
      "graceful_degradation": "show_last_known",
      "column_map": {
        "Entity":              "entity",
        "Project":             "project",
        "Qualified Units":     "qualified_units",
        "Sale Value ITD":      "sale_value_itd_aed",
        "Collected ITD":       "collected_itd_aed",
        "Paid%":               "paid_pct",
        "Paid Band":           "paid_band"
      },
      "column_types": {
        "entity":              "str",
        "project":             "str",
        "qualified_units":     "int",
        "sale_value_itd_aed":  "float",
        "collected_itd_aed":   "float",
        "paid_pct":            "float",
        "paid_band":           "str"
      },
      "aggregations": {
        "total_active_excl_pcc":    { "op": "count_filter", "col": "qualified_units", "filter": {"paid_band_ne": "PCC"} },
        "total_qualified_itd":      { "op": "sum", "col": "qualified_units" }
      },
      "units_rule": "active_excl_pcc (30,044) = app adoption / coverage denominator. all_qualified_itd (34,731) = portfolio count. Label explicitly on every render."
    },

    "R04": {
      "id": "R04",
      "label": "Total Daily Collections — All Entities (Finance Target = D+A)",
      "file": "R04_total_daily.xlsx",
      "sheet_name": 0,
      "file_type": "xlsx",
      "granularity": "daily",
      "data_date_col": "collection_date",
      "sections_used": ["S02", "S03"],
      "graceful_degradation": "show_last_known",
      "column_map": {
        "Date":              "collection_date",
        "Working Day":       "working_day_no",
        "Dues":              "dues_aed",
        "Advance":           "advance_aed",
        "D+A":               "da_aed",
        "New Sales":         "new_sales_aed",
        "DLD":               "dld_aed",
        "D+A MTD":           "da_mtd_aed",
        "Finance Target":    "finance_target_aed"
      },
      "column_types": {
        "collection_date":   "datetime",
        "working_day_no":    "int",
        "dues_aed":          "float",
        "advance_aed":       "float",
        "da_aed":            "float",
        "new_sales_aed":     "float",
        "dld_aed":           "float",
        "da_mtd_aed":        "float",
        "finance_target_aed":"float"
      },
      "aggregations": {
        "DAILY_DAYS":        { "op": "extract_list", "col": "collection_date", "format": "DD MMM" },
        "mtd_da_total":      { "op": "sum", "col": "da_aed" },
        "mtd_dues_total":    { "op": "sum", "col": "dues_aed" },
        "mtd_advance_total": { "op": "sum", "col": "advance_aed" },
        "mtd_ns_total":      { "op": "sum", "col": "new_sales_aed" }
      },
      "special": {
        "DAILY_DAYS_rule": "Extract DAILY_DAYS[] from this source ONCE. Used by all entity daily bar charts (S03). Replaces 4 duplicate days[] declarations from v5.",
        "finance_target_rule": "finance_target_aed = D+A combined monthly target. Different from MDO dues-only target in R02. Both must be labelled on-screen."
      }
    },

    "R05": {
      "id": "R05",
      "label": "Sobha Daily Collections — March 2026",
      "file": "R05_sobha_daily.xlsx",
      "sheet_name": 0,
      "file_type": "xlsx",
      "granularity": "daily",
      "data_date_col": "collection_date",
      "fixed_entity": "Sobha",
      "sections_used": ["S03"],
      "graceful_degradation": "show_last_known",
      "column_map": {
        "Date":           "collection_date",
        "Dues":           "dues_aed",
        "Advance":        "advance_aed",
        "New Sales":      "new_sales_aed",
        "D+A MTD":        "da_mtd_aed"
      },
      "column_types": {
        "collection_date": "datetime",
        "dues_aed":         "float",
        "advance_aed":      "float",
        "new_sales_aed":    "float",
        "da_mtd_aed":       "float"
      },
      "post_load": {
        "add_column": { "entity": "Sobha" }
      }
    },

    "R06": {
      "id": "R06",
      "label": "Siniya Daily Collections — March 2026",
      "file": "R06_siniya_daily.xlsx",
      "sheet_name": 0,
      "file_type": "xlsx",
      "granularity": "daily",
      "data_date_col": "collection_date",
      "fixed_entity": "Siniya",
      "sections_used": ["S03"],
      "graceful_degradation": "show_last_known",
      "column_map": {
        "Date":           "collection_date",
        "Dues":           "dues_aed",
        "Advance":        "advance_aed",
        "New Sales":      "new_sales_aed",
        "D+A MTD":        "da_mtd_aed"
      },
      "column_types": {
        "collection_date": "datetime",
        "dues_aed":         "float",
        "advance_aed":      "float",
        "new_sales_aed":    "float",
        "da_mtd_aed":       "float"
      },
      "post_load": {
        "add_column": { "entity": "Siniya" }
      }
    },

    "R07": {
      "id": "R07",
      "label": "Downtown UAQ Daily Collections — March 2026",
      "file": "R07_dt_daily.xlsx",
      "sheet_name": 0,
      "file_type": "xlsx",
      "granularity": "daily",
      "data_date_col": "collection_date",
      "fixed_entity": "DT",
      "sections_used": ["S03"],
      "graceful_degradation": "show_last_known",
      "column_map": {
        "Date":           "collection_date",
        "Dues":           "dues_aed",
        "Advance":        "advance_aed",
        "New Sales":      "new_sales_aed",
        "D+A MTD":        "da_mtd_aed"
      },
      "column_types": {
        "collection_date": "datetime",
        "dues_aed":         "float",
        "advance_aed":      "float",
        "new_sales_aed":    "float",
        "da_mtd_aed":       "float"
      },
      "post_load": {
        "add_column": { "entity": "DT" }
      }
    },

    "R08": {
      "id": "R08",
      "label": "Advance Collections Summary — CY/FY Splits, Rebate, NPV",
      "file": "R08_advance_summary.xlsx",
      "sheet_name": "Summary",
      "file_type": "xlsx",
      "granularity": "monthly",
      "data_date_col": "month",
      "sections_used": ["S01", "S05"],
      "graceful_degradation": "show_last_known",
      "column_map": {
        "Month":                  "month",
        "Year":                   "year",
        "Entity":                 "entity",
        "CY Advance":             "cy_advance_aed",
        "FY Advance":             "fy_advance_aed",
        "Total Advance":          "total_advance_aed",
        "CY Mix%":                "cy_mix_pct",
        "Rebate":                 "rebate_aed",
        "Rebate Rate%":           "rebate_rate_pct",
        "Avg Lead Days":          "avg_advance_lead_days",
        "NPV Rate%":              "npv_rate_pct"
      },
      "column_types": {
        "month":                  "datetime",
        "year":                   "int",
        "entity":                 "str",
        "cy_advance_aed":         "float",
        "fy_advance_aed":         "float",
        "total_advance_aed":      "float",
        "cy_mix_pct":             "float",
        "rebate_aed":             "float",
        "rebate_rate_pct":        "float",
        "avg_advance_lead_days":  "float",
        "npv_rate_pct":           "float"
      },
      "aggregations": {
        "CY_ADV_MIX_YTD": {
          "op": "weighted_avg",
          "numerator": "cy_advance_aed",
          "denominator": "total_advance_aed",
          "filter": {"year": 2026, "entity": "Group"},
          "multiply_100": true,
          "note": "Compute ONCE. Result = 81.1%. Referenced in S01/S03/S05. NEVER recompute per-submodule."
        },
        "AVG_ADVANCE_LEAD_DAYS": {
          "op": "mean",
          "col": "avg_advance_lead_days",
          "filter": {"entity": "Group"},
          "note": "Historical average = 248 days. Used in NPV calculation."
        },
        "advance_2025_total": {
          "op": "filter_sum", "col": "total_advance_aed",
          "filter": {"year": 2025, "entity": "Group"}
        },
        "ytd_2026_rebate": {
          "op": "filter_sum", "col": "rebate_aed",
          "filter": {"year": 2026, "entity": "Group"}
        },
        "ytd_2026_advance": {
          "op": "filter_sum", "col": "total_advance_aed",
          "filter": {"year": 2026, "entity": "Group"}
        }
      },
      "cy_fy_rule": "CY = advance on milestones due in current calendar year. FY = advance on future-year milestones. Jan 2025 CY = 70.1% (FY = 29.9%). Prior error swapped these — corrected v4+.",
      "npv_label_rule": "NPV scenario figures (652M / 21M / 31M) are PROJECTED. Always label [PROJECTED]. Never label Actual."
    },

    "R10": {
      "id": "R10",
      "label": "Agent Coverage Report — Bucket × Unit × Contact Status",
      "file": "R10_coverage.xlsx",
      "sheet_name": 0,
      "file_type": "xlsx",
      "granularity": "bucket_unit",
      "sections_used": ["S03"],
      "graceful_degradation": "show_last_known",
      "column_map": {
        "Bucket":             "bucket",
        "Allocated Units":    "allocated_units",
        "Contacted Units":    "contacted_units",
        "Coverage%":          "coverage_pct",
        "Unworked Units":     "unworked_units",
        "OD Pool":            "od_pool_aed"
      },
      "column_types": {
        "bucket":             "str",
        "allocated_units":    "int",
        "contacted_units":    "int",
        "coverage_pct":       "float",
        "unworked_units":     "int",
        "od_pool_aed":        "float"
      },
      "aggregations": {
        "siniya_unworked_pool_aed": {
          "op": "filter_sum", "col": "od_pool_aed",
          "filter": {"bucket": "Siniya"}
        }
      }
    },

    "R12": {
      "id": "R12",
      "label": "Monthly Trend — Booksize BOM & 30-Day Collection Efficiency",
      "file": "R12_trend_monthly.xlsx",
      "sheet_name": 0,
      "file_type": "xlsx",
      "granularity": "monthly",
      "data_date_col": "month",
      "sections_used": ["S04"],
      "graceful_degradation": "show_last_known",
      "column_map": {
        "Month":               "month",
        "Entity":              "entity",
        "Booksize BOM":        "booksize_bom_aed",
        "Dues Collected":      "dues_collected_aed",
        "30d Efficiency%":     "efficiency_30d_pct"
      },
      "column_types": {
        "month":               "datetime",
        "entity":              "str",
        "booksize_bom_aed":    "float",
        "dues_collected_aed":  "float",
        "efficiency_30d_pct":  "float"
      },
      "formula_note": "efficiency_30d_pct = dues_collected_aed / booksize_bom_aed * 100. 2025 avg = 34.8%. Deprecated value of 18% from v3 is WRONG — never use."
    },

    "R13": {
      "id": "R13",
      "label": "Portfolio ITD Summary — Sale Value, Collected ITD by Entity",
      "file": "R13_portfolio_itd.xlsx",
      "sheet_name": 0,
      "file_type": "xlsx",
      "granularity": "entity",
      "sections_used": ["S02"],
      "graceful_degradation": "show_last_known",
      "column_map": {
        "Entity":              "entity",
        "Sale Value ITD":      "sale_value_itd_aed",
        "Collected ITD":       "collected_itd_aed",
        "Collected ITD%":      "collected_itd_pct"
      },
      "column_types": {
        "entity":              "str",
        "sale_value_itd_aed":  "float",
        "collected_itd_aed":   "float",
        "collected_itd_pct":   "float"
      },
      "aggregations": {
        "group_sale_value_itd":  { "op": "filter_sum", "col": "sale_value_itd_aed", "filter": {"entity": "Group"} },
        "group_collected_itd":   { "op": "filter_sum", "col": "collected_itd_aed",  "filter": {"entity": "Group"} }
      }
    },

    "R16": {
      "id": "R16",
      "label": "Nationality & CIV OD Analysis",
      "file": "R16_nationality_civ_od.xlsx",
      "sheet_name": 0,
      "file_type": "xlsx",
      "granularity": "nationality_civ",
      "sections_used": ["S01"],
      "graceful_degradation": "show_last_known",
      "column_map": {
        "Nationality":       "nationality",
        "CIV Band":          "civ_band",
        "Portfolio":         "portfolio_aed",
        "MS Due ITD":        "ms_due_itd_aed",
        "OD":                "od_aed",
        "OD%":               "od_pct"
      },
      "column_types": {
        "nationality":       "str",
        "civ_band":          "str",
        "portfolio_aed":     "float",
        "ms_due_itd_aed":    "float",
        "od_aed":            "float",
        "od_pct":            "float"
      },
      "formula_rule": "od_pct = od_aed / ms_due_itd_aed * 100. NEVER divide by portfolio_aed. Boundary: this analysis LIVES IN S01. Not reproduced in S04.",
      "aggregations": {
        "civ_total_od":      { "op": "sum", "col": "od_aed" },
        "civ_total_ms_due":  { "op": "sum", "col": "ms_due_itd_aed" }
      }
    },

    "R17": {
      "id": "R17",
      "label": "SPA Legal Status Report",
      "file": "R17_spa_status.xlsx",
      "sheet_name": 0,
      "file_type": "xlsx",
      "granularity": "unit",
      "sections_used": ["S04"],
      "graceful_degradation": "show_last_known",
      "column_map": {
        "Unit ID":      "unit_id",
        "Entity":       "entity",
        "SPA Status":   "spa_status",
        "OD":           "od_aed"
      },
      "column_types": {
        "unit_id":      "str",
        "entity":       "str",
        "spa_status":   "str",
        "od_aed":       "float"
      }
    },

    "R18": {
      "id": "R18",
      "label": "Consolidated & Overdue — Master OD Report (SINGLE SOURCE OF TRUTH)",
      "file": "R18_consolidated_overdue.xlsx",
      "sheet_name": "Overdue-1",
      "file_type": "xlsx",
      "granularity": "positional_rows",
      "sections_used": ["S02", "S04", "S08"],
      "graceful_degradation": "show_last_known",
      "authority": "Single source of truth for all OD figures. Feeds OD_TODAY, OD_SOBHA, OD_SINIYA, OD_DT global constants.",

      "_read_strategy": "POSITIONAL — do NOT use header-name column_map. This sheet uses merged cells, sub-total rows, and a Grand Total row. data_loader reads by scanning row labels in col[0]. openpyxl data_only=True.",

      "sheet_structure": {
        "active_sheet": "Overdue-1",
        "total_sheets_in_workbook": 27,
        "read_mode": "positional_row_scan",
        "header_date_cell": "Read snapshot date from a header cell (row 0 or 1) — exact cell confirmed on first file inspection. Store as SNAPSHOT_DATE. Never hardcode.",
        "col_index_note": "Column indices are 0-based as returned by openpyxl iter_rows(values_only=True)."
      },

      "positional_columns": {
        "col_0":  "row_label — used to identify Grand Total and Sub Total rows",
        "col_8":  "ageing_0_30_aed",
        "col_9":  "ageing_31_60_aed",
        "col_10": "ageing_61_90_aed",
        "col_11": "ageing_91_120_aed",
        "col_12": "ageing_121_180_aed",
        "col_13": "ageing_180plus_aed",
        "col_14": "total_od_aed"
      },

      "row_identification": {
        "grand_total_row": {
          "match_col": 0,
          "match_value": "Grand Total",
          "match_strategy": "str_contains_case_insensitive",
          "reads": ["col_8","col_9","col_10","col_11","col_12","col_13","col_14"],
          "produces": ["OD_TODAY", "ageing_0_30", "ageing_31_60", "ageing_61_90", "ageing_91_120", "ageing_121_180", "ageing_180plus"]
        },
        "sobha_subtotals": {
          "match_col": 0,
          "match_values": ["Sub Total (A)","Sub Total (B)","Sub Total (C)","Sub Total (D)","Sub Total (E)"],
          "match_strategy": "str_exact_case_insensitive",
          "reads": ["col_14"],
          "aggregation": "sum",
          "produces": "OD_SOBHA",
          "note": "Sections A through E = Sobha entity. Sum col[14] across all five Sub Total rows."
        },
        "siniya_subtotal": {
          "match_col": 0,
          "match_value": "Sub Total (F)",
          "match_strategy": "str_exact_case_insensitive",
          "reads": ["col_14"],
          "produces": "OD_SINIYA",
          "note": "Section F = Siniya entity. Single Sub Total row."
        },
        "dt_subtotal": {
          "match_col": 0,
          "match_value": "Sub Total (G)",
          "match_strategy": "str_exact_case_insensitive",
          "reads": ["col_14"],
          "produces": "OD_DT",
          "note": "Section G = Downtown UAQ entity. Single Sub Total row."
        }
      },

      "aggregations": {
        "OD_TODAY": {
          "source_row": "grand_total_row",
          "source_col": "col_14",
          "validated_value": 1650100000,
          "validated_as_of": "2026-03-15",
