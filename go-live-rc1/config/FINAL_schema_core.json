  "total_datasets": 38,

  "naming_convention": {
    "fields": "snake_case throughout",
    "monetary": "All values in AED",
    "ratios": "Decimal unless _pct suffix (then 0–100 scale)",
    "ids": "R01–R38 for datasets; M001–M058 for metrics; S01–S08 for sections"
  },

  "global_constants": {
    "OD_TODAY":              { "value_aed": 1650100000,  "source": "R18", "date": "2026-03-15", "rule": "NEVER hardcode — refresh on load from R18. Three deprecated hardcoded instances (S02/S04/S08) replaced by this constant." },
    "PIPELINE_GROSS":        { "value_aed": 43500000000, "source": "R36", "label": "Total Forward Pipeline — remaining milestones all active bookings", "used_in": ["S02","S04"] },
    "PIPELINE_FORWARD_BOOK": { "value_aed": 40000000000, "source": "Narrative approximation", "label": "~Opening 2025 Book — narrative context only", "used_in": ["S01 narrative"] },
    "PIPELINE_ADV_DENOM":    { "value_aed": 37800000000, "source": "R36 derived", "label": "2026 Advance Penetration Denominator = 43.5B − 5.7B prior advances", "used_in": ["S05","S08"] },
    "CY_ADV_MIX_YTD":        { "value_pct": 81.1,        "source": "R08", "note": "Computed once — referenced in S01, S03, S05. NEVER recompute per-section." },
    "DAILY_DAYS":            { "source": "R04", "note": "Single shared array replacing 4 duplicate days[] declarations in entity closures." },
    "WORKING_DAYS_MONTH":    { "value": 21,               "source": "Calendar", "note": "March 2026 actual = 21. Deprecated hardcoded 22 removed." }
  },

  "critical_definitions": {
    "od_pct_denominator":        "ALWAYS use ms_due_itd_aed. NEVER use purchase_price_aed. Purchase price understates delinquency (India: 2% wrong → 4.33% correct).",
    "finance_vs_mdo_target":     "Finance target = D+A combined (Jan = 909M). MDO target = Dues-only (Jan = 700.5M, separate advance target). Achievement% differs across both systems. Label explicitly in every report.",
    "cy_vs_fy_advance":          "CY = advance on milestones due in current calendar year. FY = advance on future-year milestones. Jan 2025 CY = 70.1%; FY = 29.9%. Prior error swapped these — corrected v4+.",
    "active_vs_qualified_units": "active_excl_pcc = 30,044 (use for app adoption, coverage). all_qualified_itd = 34,731 (use for portfolio count). Label explicitly — never mix.",
    "pipeline_figures":          "PIPELINE_GROSS 43.5B ≠ PIPELINE_FORWARD_BOOK ~40B ≠ PIPELINE_ADV_DENOM 37.8B. These are three distinct numbers with different scopes. Always display with inline label.",
    "npv_scenario_labels":       "652M / 21M / 31M are PROJECTED figures from a proposal model — never label as Actual.",
    "od_today_source_of_truth":  "R18 (2026-03-15). Sobha=1,472.7M; Siniya=166.4M; DT=11.0M; Group=1,650.1M. DO NOT use strategy doc estimate of 1.57B for Sobha.",
    "collector_data_currency":   "All collector arrays are Mar 2026 MTD snapshot. Label 'Snapshot: Mar 2026 MTD'. No live refresh mechanism.",
    "app_payment_basis":         "App payment share is COUNT basis (transaction count), not AED value. Do not convert."
  },

  "deprecated_items": [
    { "item": "OD Today hardcoded ×3",       "locations": "S02/S04/S08",  "replacement": "OD_TODAY constant from R18" },
    { "item": "Entity toggle ×10 (story-etog, ann-etog, mdo-etog, fin-etog, mix-etog, port-etog, lp-etog, pu-etog + 2 others)", "replacement": "Single shared etog component" },
    { "item": "days[] array ×4",              "locations": "S03 entity closures", "replacement": "DAILY_DAYS[] constant" },
    { "item": "c-mdo2",                       "locations": "S02", "replacement": "REMOVED — purpose unconfirmed, not in v6" },
    { "item": "Finance toggle inline onclick","locations": "S02", "replacement": "etog/ev pattern" },
    { "item": "Working days hardcoded = 22",  "replacement": "WORKING_DAYS_MONTH variable" },
    { "item": "NPV figures labelled 'Actual'","locations": "S01/S05", "replacement": "Labelled [PROJECTED]" },
    { "item": "v5 org chart",                 "locations": "S07", "replacement": "Rebuilt from confirmed reporting lines" },
    { "item": "OD% = OD ÷ Purchase Price",   "versions": "v1–v3", "replacement": "OD% = OD ÷ MS Due ITD (corrected v4+)" },
    { "item": "Advance monthly arrays redeclared in JS block", "replacement": "Module-level declaration only; shadow risk removed" },
    { "item": "c-adv-3yr in S01",            "replacement": "Moved exclusively to S05 as c-adv-hist TREND_PANEL" }
  ],

