          "op": "sum", "col": "forward_obligation_aed",
          "note": "= 43.5B. Label: 'Total Forward Pipeline (R36)'. Used in S02, S04."
        },
        "PIPELINE_ADV_DENOM": {
          "op": "derived",
          "formula": "PIPELINE_GROSS - 5_700_000_000",
          "note": "= 37.8B = 43.5B − 5.7B prior advances. Label: '2026 Advance Penetration Denominator'. Used in S05 and S08 ONLY."
        }
      },
      "pipeline_rule": "PIPELINE_GROSS (43.5B) ≠ PIPELINE_FORWARD_BOOK (~40B) ≠ PIPELINE_ADV_DENOM (37.8B). Three distinct figures. Always display with inline label. Never show unlabelled pipeline figure.",
