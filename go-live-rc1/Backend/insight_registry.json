{
  "$schema": "scip.insight_registry.v1",
  "registry_version": "wave_b_livepulse_2026_06_04",
  "intent": "Wave B evolves the Live Pulse critical insights from single-outcome static frames to data-state-keyed deterministic frames, and degrades them to blocked/unavailable instead of an ungated number when the lineage gate fails. Only the three Live Pulse surfaces (current_signal, month_movement, risk_action) are in scope. All other insights remain Wave A faithful (static) until Wave C/D. Numbers still originate ONLY from governed values; frames never originate a number.",

  "cutover": {
    "wave": "B",
    "default_mode": "shadow",
    "live_surfaces": [
      { "route": "live_pulse", "focus": "current_signal" },
      { "route": "live_pulse", "focus": "month_movement" },
      { "route": "live_pulse", "focus": "risk_action" }
    ],
    "gate_note": "Frontend renders live frames for these surfaces only when SCIP_INSIGHT_CUTOVER=live_pulse AND live shadow parity (Wave A) was confirmed green on Render. Default is shadow: dropping the files in changes nothing until the env is flipped."
  },

  "frame_sets": {
    "exposure_level": {
      "rising":  "{subject} has risen to {value} ({basis}).",
      "falling": "{subject} has eased to {value} ({basis}).",
      "flat":    "{subject} holds at {value} ({basis}).",
      "level":   "{subject} stands at {value} ({basis}).",
      "blocked": "{subject} unavailable — trusted lineage gate failed ({source}). No fallback figure published."
    },
    "collection_level": {
      "rising":  "{subject} up to {value} ({basis}).",
      "falling": "{subject} at {value}, below the prior snapshot ({basis}).",
      "flat":    "{subject} steady at {value} ({basis}).",
      "level":   "{subject} at {value} ({basis}).",
      "blocked": "{subject} unavailable — Finance lineage gate failed ({source}). No fallback figure published."
    },
    "pacing_ratio": {
      "breach":  "Pacing risk: {subject} at {value} ({basis}).",
      "ok":      "Pacing on track: {subject} at {value} ({basis}).",
      "level":   "{subject}: {value} ({basis}).",
      "blocked": "{subject} unavailable — target or actual lineage missing ({source})."
    }
  },

