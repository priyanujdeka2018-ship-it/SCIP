# SCIP staging template - do not commit real secrets
SCIP_ENV=staging
SCIP_AUTH_MODE=jwt
SCIP_LOCAL_DEV_BYPASS=false
SCIP_JWT_ISSUER=
SCIP_JWT_AUDIENCE=
SCIP_JWKS_URL=
DATABASE_URL=
SCIP_ALLOWED_ORIGINS=
SCIP_BACKUP_TARGET=
SCIP_OBSERVABILITY_ENABLED=true
SCIP_DATA_DIR=/opt/render/project/src/data
SCIP_AUDIT_EXPORT_DIR=/opt/render/project/src/Backend/audit_exports
