# SCIP environment template for staging/production

# Environment
SCIP_ENV=staging
SCIP_BASE_URL=https://staging-scip.example.com
SCIP_API_BASE_URL=https://staging-scip-api.example.com
SCIP_FRONTEND_ORIGIN=https://staging-scip.example.com
SCIP_ALLOWED_ORIGINS=https://staging-scip.example.com
SCIP_CORS_ALLOW_WILDCARD=false

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/scip
PROD_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/scip_prod
SCIP_DB_SSLMODE=require
SCIP_DB_POOL_SIZE=10
SCIP_DB_POOL_TIMEOUT_SECONDS=30

# Authentication / SSO JWT
SCIP_AUTH_MODE=jwt
SCIP_LOCAL_DEV_BYPASS=false
SCIP_JWT_ISSUER=https://idp.example.com/tenant
SCIP_JWT_AUDIENCE=api://scip
SCIP_JWT_JWKS_URL=https://idp.example.com/tenant/.well-known/jwks.json
SCIP_JWT_ALGORITHMS=RS256
SCIP_JWT_CLOCK_SKEW_SECONDS=60
SCIP_SESSION_MAX_AGE_SECONDS=3600

# Local deterministic smoke only. Do not set in production.
SCIP_JWT_HS256_SECRET=

# Source files
SCIP_SOURCE_ROOT=/data/scip/r-series
SCIP_SOURCE_ARCHIVE_ROOT=/data/scip/archive
SCIP_CRITICAL_R_CODES=R02,R04,R08,R18,R36,R09,R10,R17,R20,R30,R31,R32,R34,R38
SCIP_NO_SILENT_FALLBACK=true
SCIP_RECONCILIATION_TOLERANCE_PCT=0.05

# Observability
SCIP_LOG_LEVEL=INFO
SCIP_STRUCTURED_LOGGING=true
SCIP_REDACT_SENSITIVE_FIELDS=true
SCIP_METRICS_ENABLED=true
SCIP_CORRELATION_ID_HEADER=X-Correlation-ID
SCIP_FRONTEND_TIMING_ENABLED=true

# Notifications
SCIP_NOTIFICATIONS_ENABLED=true
SCIP_NOTIFICATION_EXTERNAL_DELIVERY=false
SCIP_NOTIFICATION_DEDUPE_ENABLED=true
SCIP_NOTIFICATION_SUPPRESSION_ENABLED=true

# Backup / restore
SCIP_BACKUP_BUCKET=s3://scip-backups
SCIP_BACKUP_RETENTION_DAYS=30
SCIP_BACKUP_KMS_KEY_ID=
SCIP_RESTORE_TEST_ENABLED=true

# Deployment
SCIP_MIGRATION_LOCK_TIMEOUT_SECONDS=300
SCIP_HEALTHCHECK_TIMEOUT_SECONDS=30
SCIP_DEPLOYMENT_RELEASE_ID=
SCIP_BUILD_SHA=
